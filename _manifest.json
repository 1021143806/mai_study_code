{
  "manifest_version": 2,
  "version": "0.2.0",
  "name": "麦麦学代码 (Mai Study Code)",
  "description": "麦麦的代码学习伙伴，不是工具而是陪你一起成长的同路人。从零开始学代码，会自己写笔记、攒经验，不懂就问，有风险就提醒。让麦麦一步步成长为系统管理员。（root功能不支持windows）",
  "author": {
    "name": "Ptrel",
    "url": "https://github.com/1021143806/mai_study_code"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/1021143806/mai_study_code",
    "homepage": "https://github.com/1021143806/mai_study_code",
    "documentation": "https://github.com/1021143806/mai_study_code",
    "issues": "https://github.com/1021143806/mai_study_code/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.0.0"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.hybrid",
    "config.get",
    "chat.open_session",
    "llm.generate",
    "llm.generate_with_tools"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "maibot-team.mai-study-code"
}
